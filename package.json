{
  "name": "xpro",
  "version": "0.1.1",
  "description": "Xpro — a runnable multi-agent process with a built-in evaluation system (OpenAI & Anthropic)",
  "author": "Hopkey",
  "license": "MIT",
  "main": "dist/framework/index.js",
  "bin": {
    "xpro": "dist/runtime/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/framework/index.d.ts",
      "default": "./dist/framework/index.js"
    },
    "./framework": {
      "types": "./dist/framework/index.d.ts",
      "default": "./dist/framework/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/cli.d.ts",
      "default": "./dist/runtime/cli.js"
    }
  },
  "scripts": {
    "build": "npm run build:runtime",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:framework": "tsc -p tsconfig.framework.json",
    "start": "node dist/runtime/cli.js",
    "serve": "node dist/runtime/cli.js serve",
    "eval": "node dist/runtime/cli.js eval evals/starter.json",
    "ide": "npm run ide:build && electron dist/main/index.js",
    "ide:dev": "concurrently \"npm run ide:dev:main\" \"npm run ide:dev:renderer\" \"npm run ide:dev:electron\"",
    "ide:dev:main": "tsc -p tsconfig.main.json --watch",
    "ide:dev:renderer": "webpack serve --config webpack.renderer.js --mode development",
    "ide:dev:electron": "wait-on http://localhost:9080 && cross-env NODE_ENV=development electron dist/main/index.js",
    "ide:build": "tsc -p tsconfig.main.json && webpack --config webpack.renderer.js --mode production && cd native && npm run build",
    "ide:pack": "electron-builder --dir",
    "ide:dist": "electron-builder"
  },
  "dependencies": {
    "monaco-editor": "^0.50.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.0.0",
    "monaco-editor-webpack-plugin": "^7.0.0",
    "rcedit": "^5.0.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^5.0.0"
  },
  "build": {
    "appId": "com.hopkey.xpro",
    "productName": "Xpro",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "./build/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
